{
  "name": "jade-psycho.fr",
  "version": "0.2.0",
  "private": true,
  "description": "Jade psycho website",
  "author": "Olivier Leclercq",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "push": "gh-pages -d out --nojekyll --cname www.jade-psycho.fr",
    "deploy": "npm run build && npm run push",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.81.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "gh-pages": "^6.2.0",
    "postcss": "^8",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "keywords": [
    "react",
    "nextjs"
  ],
  "license": "MIT",
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "$@playwright/test"
    }
  }
}
